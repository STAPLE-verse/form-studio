{
  "name": "@staple-verse/form-studio",
  "version": "0.2.0-rc.0",
  "description": "Visual JSON Schema form builder and preview studio for React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STAPLE-verse/form-studio.git"
  },
  "bugs": {
    "url": "https://github.com/STAPLE-verse/form-studio/issues"
  },
  "homepage": "https://github.com/STAPLE-verse/form-studio#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./semantic-v1": {
      "types": "./dist/semantic-v1.d.ts",
      "import": "./dist/semantic-v1.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "npm run test:capabilities && npm run test:integration && npm run test:packaging",
    "test:capabilities": "tsup --config tsup.test.config.ts && node .test-dist/capability-fixtures.test.js",
    "test:integration": "vitest run tests/semantic-integration.test.tsx tests/extension-registry.test.tsx tests/extension-outlets.test.tsx",
    "test:packaging": "npm run build && node scripts/verify-package-outputs.mjs",
    "test:packed-consumers": "npm run build && node scripts/verify-packed-consumers.mjs",
    "test:staple:packed": "npm run build && node scripts/verify-staple-packed.mjs",
    "test:clean-install": "node scripts/verify-clean-install.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "daisyui": "^4.6.1 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.3.3 || ^4.0.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@staple-verse/marker-template-runtime": "https://github.com/STAPLE-verse/marker-template-spec/releases/download/v1.0.0-rc.3/staple-verse-marker-template-runtime-1.0.0-rc.3.tgz",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@rjsf/core": "^6.6.2",
    "@rjsf/utils": "^6.6.2",
    "@rjsf/validator-ajv8": "^6.6.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "daisyui": "^5.7.4",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
