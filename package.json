{
  "name": "@staple-verse/form-studio",
  "version": "0.1.0",
  "description": "Visual JSON Schema form builder and preview studio for React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STAPLE-verse/form-studio.git"
  },
  "bugs": {
    "url": "https://github.com/STAPLE-verse/form-studio/issues"
  },
  "homepage": "https://github.com/STAPLE-verse/form-studio#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@rjsf/core": "^6.6.2",
    "@rjsf/utils": "^6.6.2",
    "@rjsf/validator-ajv8": "^6.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0"
  }
}
